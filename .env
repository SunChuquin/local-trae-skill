# 服务配置
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Chroma 向量数据库配置
CHROMA_PERSIST_DIRECTORY=./data/chroma

# BGE 嵌入模型配置
# 使用本地模型（已下载）：
EMBEDDING_MODEL=../models/bge-base-zh-v1.5
# 或使用在线模型（需要网络）：
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# 文档分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 上传处理并发上限：一次只处理一个文档，避免 CPU 并发向量化卡死（电脑性能好可调到 2）
MAX_CONCURRENT_UPLOADS=1

# 定时摘要更新任务（每 24 小时自动更新知识库摘要，默认关闭；如需开启改为 true）
SCHEDULE_SUMMARY_ENABLED=false

# 检索配置
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.5

# 备份配置
BACKUP_DIRECTORY=./data/backup

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
